# ═══════════════════════════════════════════════════════════════
# SHAMIKH LUXURY OS — Environment Variables
# Copy this file to .env.local and fill in all values before running
# ═══════════════════════════════════════════════════════════════

# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from your Supabase project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── JWT / Session Security ──────────────────────────────────────────────────
# CRITICAL: Must be at least 64 characters, cryptographically random
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your_super_secret_key_minimum_64_characters_long_replace_this_now

# ─── Stripe Payments ─────────────────────────────────────────────────────────
# Get from Stripe Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── App Configuration ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://shamikh-luxury.com
NEXT_PUBLIC_APP_NAME=SHAMIKH LUXURY OS
NODE_ENV=production

# ─── AI / Smart Features ─────────────────────────────────────────────────────
# Optional: For real AI-powered descriptions and recommendations
# Get from Google AI Studio: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=AIza...

# ─── Admin Security ──────────────────────────────────────────────────────────
# Comma-separated list of phone numbers allowed to access admin panel
# Format: +966501234567,+971501234567
ADMIN_ALLOWED_PHONES=+966501234567

# ─── AliExpress / Dropshipping ───────────────────────────────────────────────
# Optional: For enhanced real product scraping (leave blank to use simulator)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_ACCESS_TOKEN=

# ─── Email Notifications (Optional) ──────────────────────────────────────────
# Optional: For order confirmation emails (uses Resend.com)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@shamikh-luxury.com

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Optional: Use Upstash Redis for distributed rate limiting across multiple Vercel regions
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# ─── Analytics (Optional) ────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-...

# ─── Local Development Overrides ─────────────────────────────────────────────
# These settings work for local development without Supabase configured.
# The system automatically falls back to high-fidelity mock data.
#
# To run locally without any external services:
#   1. cp .env.example .env.local
#   2. Set SESSION_SECRET to any 64-char string
#   3. Leave all other values empty (mock mode auto-activates)
#   4. npm run dev
